---
interface Props { eyebrow: string; title: string; subtitle?: string }
const { eyebrow, title, subtitle } = Astro.props;
---
<section class="border-b border-line bg-paper">
  <div class="container-x py-20 sm:py-24">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="mt-5 max-w-3xl text-4xl leading-tight sm:text-5xl">{title}</h1>
    <div class="rule mt-8"></div>
    {subtitle && <p class="mt-8 max-w-2xl text-lg leading-relaxed text-muted">{subtitle}</p>}
  </div>
</section>
