---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

const items = [
  { title: 'Conozca a su cliente (KYC)', text: 'Identificamos y verificamos a cada proveedor y cliente antes de iniciar cualquier operación.' },
  { title: 'Prevención de lavado de activos', text: 'Aplicamos controles para detectar y reportar operaciones inusuales conforme a la normativa vigente.' },
  { title: 'Origen responsable', text: 'Solicitamos documentación que respalde el origen lícito del oro y evitamos zonas de conflicto o de alto riesgo.' },
  { title: 'Trazabilidad', text: 'Registramos cada lote con su documentación, pesaje y ensayo, manteniendo la cadena de custodia.' },
];
---
<Layout title="Cumplimiento" description="Políticas de debida diligencia, KYC, prevención de lavado de activos y origen responsable de RedGold S.R.L.">
  <PageHero eyebrow="Cumplimiento" title="Transparencia en cada operación" subtitle="Nuestro compromiso con la legalidad y el abastecimiento responsable es la base de nuestro trabajo." />
  <section class="container-x py-24">
    <div class="grid border-t border-line md:grid-cols-2">
      {items.map((i) => (
        <div class="border-b border-line py-10 md:odd:pr-12 md:even:border-l md:even:pl-12">
          <h2 class="text-xl">{i.title}</h2>
          <p class="mt-4 leading-relaxed text-muted">{i.text}</p>
        </div>
      ))}
    </div>
    <!-- TODO: añadir registros, licencias y políticas descargables (PDF) en public/docs/ -->
    <p class="mt-12 border-l-4 border-red bg-paper p-6 text-muted">
      Si requiere nuestra documentación corporativa o políticas de cumplimiento,
      <a href="/contacto" class="text-red underline underline-offset-4">solicítela aquí</a>.
    </p>
  </section>
</Layout>
