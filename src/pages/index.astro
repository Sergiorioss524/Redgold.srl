---
import Layout from '../layouts/Layout.astro';
import GoldPrice from '../components/GoldPrice.astro';

const services = [
  { title: 'Compra de oro', text: 'Adquirimos oro de productores y proveedores con documentación de origen verificable y liquidaciones transparentes.' },
  { title: 'Venta y comercialización', text: 'Suministramos oro a refinerías, joyeros y compradores institucionales bajo condiciones claras.' },
  { title: 'Exportación', text: 'Gestionamos la logística, documentación y permisos necesarios para operaciones internacionales.' },
];

const values = [
  { k: 'Trazabilidad', v: 'Cada lote cuenta con registro de origen y cadena de custodia.' },
  { k: 'Transparencia', v: 'Pesaje, ensayo y liquidación claros en cada operación.' },
  { k: 'Cumplimiento', v: 'Procesos de debida diligencia y prevención de lavado de activos.' },
  { k: 'Seguridad', v: 'Manejo y transporte del metal bajo protocolos de seguridad.' },
];
---
<Layout>
  <!-- Portada -->
  <section class="border-b border-line">
    <div class="container-x grid items-center gap-16 py-24 lg:grid-cols-12 lg:py-32">
      <div class="lg:col-span-7">
        <p class="eyebrow">Comercializadora Minera</p>
        <h1 class="mt-6 text-4xl leading-[1.15] sm:text-5xl">
          Comercialización de oro con respaldo, trazabilidad y cumplimiento normativo
        </h1>
        <div class="rule mt-10"></div>
        <p class="mt-8 max-w-xl text-lg leading-relaxed text-muted">
          Conectamos la producción minera con refinerías y compradores nacionales e internacionales
          mediante operaciones seguras, debidamente documentadas y conformes a la normativa vigente.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a href="/contacto" class="btn-primary">Solicitar cotización</a>
          <a href="/servicios" class="btn-outline">Conocer servicios</a>
        </div>
      </div>
      <!-- Reemplaza este panel por una fotografía corporativa: <img src="/images/hero.jpg" class="..." alt="..."> -->
      <div class="lg:col-span-5">
        <div class="border-l-4 border-red bg-paper p-10">
          <p class="eyebrow text-muted">Áreas de servicio</p>
          <ul class="mt-6 divide-y divide-line">
            {services.map((s, i) => (
              <li class="flex items-baseline gap-5 py-5">
                <span class="font-heading font-bold text-red">{String(i + 1).padStart(2, '0')}</span>
                <span class="font-heading font-bold text-xl">{s.title}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Precio del oro en vivo -->
  <section class="container-x pt-24">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Mercado</p>
        <h2 class="mt-4 text-3xl sm:text-4xl">Precio del oro hoy</h2>
      </div>
      <a href="/precio-del-oro" class="text-sm text-muted hover:text-red">Cómo se calcula el precio →</a>
    </div>
    <div class="mt-10"><GoldPrice /></div>
  </section>

  <!-- Servicios -->
  <section class="container-x py-24">
    <div class="max-w-2xl">
      <p class="eyebrow">Qué hacemos</p>
      <h2 class="mt-4 text-3xl sm:text-4xl">Servicios</h2>
    </div>
    <div class="mt-12 grid border-t border-line md:grid-cols-3">
      {services.map((s) => (
        <div class="border-b border-line py-10 md:border-b-0 md:pr-10 md:[&:not(:first-child)]:border-l md:[&:not(:first-child)]:pl-10">
          <h3 class="text-xl">{s.title}</h3>
          <p class="mt-4 leading-relaxed text-muted">{s.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Valores -->
  <section class="bg-paper">
    <div class="container-x grid gap-12 py-24 lg:grid-cols-3">
      <div>
        <p class="eyebrow">Por qué RedGold</p>
        <h2 class="mt-4 text-3xl sm:text-4xl">Nuestros principios</h2>
        <div class="rule mt-8"></div>
      </div>
      <dl class="grid gap-10 sm:grid-cols-2 lg:col-span-2">
        {values.map((x) => (
          <div>
            <dt class="font-heading font-bold text-xl">{x.k}</dt>
            <dd class="mt-3 leading-relaxed text-muted">{x.v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Llamada a la acción -->
  <section class="container-x pt-24">
    <div class="flex flex-col items-start justify-between gap-8 border-y border-line py-12 md:flex-row md:items-center">
      <div>
        <h2 class="text-2xl sm:text-3xl">¿Desea comprar o vender oro?</h2>
        <p class="mt-3 text-muted">Contáctenos y uno de nuestros representantes le responderá a la brevedad.</p>
      </div>
      <a href="/contacto" class="btn-primary">Contactar</a>
    </div>
  </section>
</Layout>
