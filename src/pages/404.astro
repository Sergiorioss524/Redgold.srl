---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Página no encontrada" description="La página que busca no existe." noindex>
  <section class="container-x py-32 text-center">
    <p class="eyebrow">Error 404</p>
    <h1 class="mt-5 text-4xl sm:text-5xl">Página no encontrada</h1>
    <div class="rule mx-auto mt-8"></div>
    <p class="mt-8 text-muted">La página que busca no existe o fue movida.</p>
    <a href="/" class="btn-primary mt-10">Volver al inicio</a>
  </section>
</Layout>
